Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 "Functions for numerically inverting Laplace transforms with the ",
 StyleBox["Euler",
  FontSlant->"Italic"],
 " algorithm of Abate and Whitt."
}], "Subsection",
 CellChangeTimes->{{3.5510721624742002`*^9, 3.5510722116949997`*^9}, {
   3.890112923230448*^9, 3.890113000976716*^9}, {3.890136812746831*^9, 
   3.890136831897992*^9}, {3.890218882592693*^9, 3.890218895406287*^9}, {
   3.890221480854023*^9, 3.8902214910738163`*^9}, {3.890221687146427*^9, 
   3.890221689661451*^9}, {4.0045277970367527`*^9, 4.0045278044661694`*^9}, {
   4.004527872732828*^9, 4.0045279103183994`*^9}, {4.004527945317768*^9, 
   4.004527998092886*^9}, {4.004528106861023*^9, 4.0045281071790276`*^9}, 
   4.004531581021263*^9},
 Background->None,ExpressionUUID->"e55ddde4-222f-4df7-bca2-323f40737994"],

Cell[CellGroupData[{

Cell[TextData[{
 "The basic function for numerically inverting Laplace transforms: ",
 StyleBox["EulerILT",
  FontWeight->"Bold"]
}], "Subsubsection",
 CellChangeTimes->{{3.8897617036321354`*^9, 3.889761736847932*^9}, 
   3.8897618211064625`*^9, {3.8897620935343246`*^9, 3.889762103582576*^9}, 
   3.8897904153491473`*^9, {3.8897950075362387`*^9, 3.88979501814273*^9}, {
   3.8901130192468185`*^9, 3.8901130361220045`*^9}, {3.8902189313450117`*^9, 
   3.890218937812254*^9}, 3.8902212066287775`*^9, {4.004528014858591*^9, 
   4.0045280782440376`*^9}, 4.0045315978261204`*^9},
 Background->None,ExpressionUUID->"11aaf384-5ac0-49ad-a848-f0e5dca487fc"],

Cell[TextData[{
 "The parameters ",
 StyleBox["aa",
  FontWeight->"Bold"],
 ", ",
 StyleBox["ntr",
  FontWeight->"Bold"],
 " and ",
 StyleBox["mEuler",
  FontWeight->"Bold"],
 " correspond to the parameters ",
 StyleBox["A",
  FontSlant->"Italic"],
 ", ",
 StyleBox["n",
  FontSlant->"Italic"],
 " and ",
 StyleBox["m",
  FontSlant->"Italic"],
 " of the paper  Abate, J. & Whitt, W. The Fourier-series method for \
inverting transforms of probability distributions. Queueing Systems 10, 5\
\[Dash]87 (1992). https://doi.org/10.1007/BF01158520. Here we use the values \
aa = 19.1, ntr = 15 and mEuler = 11 of the Euler algorithm on pages 7\[Dash]8 \
of that paper. In Abate, J. and Whitt, W., Numerical inversion of Laplace \
transforms of probability distributions, ORSA Journal on Computing 7, 36\
\[Dash]43 (1995), http://dx.doi.org/10.1287/ijoc.1050.0137, the authors use \
aa = 18.4 instead of 19.1, with the same ntr and mEuler."
}], "Text",
 CellChangeTimes->{{3.8901164699270115`*^9, 3.8901165690522103`*^9}, {
   3.8901317823986435`*^9, 3.8901317994130373`*^9}, {3.8901354381313596`*^9, 
   3.8901355633310485`*^9}, {3.890136881761015*^9, 3.8901369088883843`*^9}, {
   3.890219199897743*^9, 3.890219274073723*^9}, {4.0044520416743336`*^9, 
   4.0044520603402424`*^9}, {4.004452103038021*^9, 4.004452119661545*^9}, 
   4.0044521602838554`*^9, {4.004452245496237*^9, 4.0044523046570473`*^9}, {
   4.004528082978964*^9, 4.004528083493244*^9}, 4.004528358531084*^9, {
   4.0045316254906654`*^9, 4.0045316741989975`*^9}},
 Background->None,ExpressionUUID->"3a8a8019-4600-4073-9805-61c15f898dc6"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EulerILT", "[", 
    RowBox[{"funs_", ",", 
     RowBox[{"t_", "?", "Positive"}], ",", "argu_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aa", "=", "19.1"}], ",", 
       RowBox[{"ntr", "=", "15"}], ",", 
       RowBox[{"mEuler", "=", "11"}], ",", "hh", ",", "xx", ",", "uu", ",", 
       "c", ",", "su", ",", "nn", ",", "avgsu"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"hh", "=", 
       RowBox[{"N", "[", 
        RowBox[{"Pi", "/", "t"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xx", "=", 
       RowBox[{"aa", "/", 
        RowBox[{"(", 
         RowBox[{"2.", "*", "t"}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"uu", "=", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"aa", "/", "2."}], "]"}], "/", "t"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{"mEuler", ",", 
           RowBox[{"m", "-", "1"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "1", ",", 
           RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"su", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0.", ",", 
         RowBox[{"{", 
          RowBox[{"mEuler", "+", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"su", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"funs", "[", 
           RowBox[{"xx", ",", "argu"}], "]"}], "]"}], "/", "2."}], "+", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
           RowBox[{"Re", "[", 
            RowBox[{"funs", "[", 
             RowBox[{
              RowBox[{"xx", "+", 
               RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], "]"}], 
            "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"nn", ",", "1", ",", "ntr"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"nn", "=", 
          RowBox[{"ntr", "+", "k"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"su", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"su", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
            RowBox[{"Re", "[", 
             RowBox[{"funs", "[", 
              RowBox[{
               RowBox[{"xx", "+", 
                RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], "]"}], 
             "]"}]}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "mEuler"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"avgsu", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "*", 
          RowBox[{"su", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"uu", "*", 
       RowBox[{"avgsu", "/", 
        RowBox[{"2", "^", "mEuler"}]}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.004515522165806*^9, 4.004515543307024*^9}, 
   4.004515597818737*^9, {4.004515632907177*^9, 4.0045156332037563`*^9}, {
   4.0045164652598667`*^9, 4.004516466539055*^9}, {4.0045239882085667`*^9, 
   4.004523998426243*^9}},
 Background->None,
 CellLabel->"In[70]:=",ExpressionUUID->"e3afa34b-6039-ae45-849d-e41e964ecd1f"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The function  ",
 StyleBox["EulerILTwithErrors",
  FontWeight->"Bold"]
}], "Subsubsection",
 CellChangeTimes->{{3.8897617036321354`*^9, 3.889761736847932*^9}, 
   3.8897618211064625`*^9, {3.8897620935343246`*^9, 3.889762103582576*^9}, 
   3.8897904153491473`*^9, {3.8897950075362387`*^9, 3.88979501814273*^9}, {
   3.8901130192468185`*^9, 3.8901130361220045`*^9}, 3.8902213802668147`*^9, {
   4.004537529109991*^9, 4.004537531966181*^9}},
 Background->None,ExpressionUUID->"5f2c8658-e67e-4384-9984-97e736675a24"],

Cell[TextData[{
 StyleBox["EulerILTwithErrors",
  FontWeight->"Bold"],
 ":\nThis function computes the numerical inverse and also estimates its \
error. It returns {value, truncation error, discretization error, total error \
estimate}; the value is the same as that returned by EulerILT, and the total \
estimate is the sum of the other two errors. The internal function euler[tt] \
is the Euler algorithm already implemented in EulerILT."
}], "Text",
 CellChangeTimes->{{4.0044524572538776`*^9, 4.0044525122309437`*^9}, {
   4.0045276735527*^9, 4.004527720455862*^9}, 4.0045317344873714`*^9, {
   4.004533397441639*^9, 4.0045333992404423`*^9}, 4.004534852779249*^9},
 Background->None,ExpressionUUID->"2c49267b-3624-ec4e-ab1f-003e422859dd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EulerILTwithErrors", "[", 
    RowBox[{"funs_", ",", 
     RowBox[{"t_", "?", "Positive"}], ",", "argu_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aa", "=", "19.1"}], ",", 
       RowBox[{"ntr", "=", "15"}], ",", 
       RowBox[{"mEuler", "=", "11"}], ",", "c", ",", "euler", ",", "v", ",", 
       "v3", ",", "errt", ",", "errd"}], "}"}], ",", 
     RowBox[{
      RowBox[{"c", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{"mEuler", ",", 
           RowBox[{"m", "-", "1"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "1", ",", 
           RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"euler", "[", "tt", "]"}], " ", "returns", " ", 
        RowBox[{"{", 
         RowBox[{"fun", ",", "fun1"}], "}"}], " ", "at", " ", "time", " ", 
        "tt"}], " ", "*)"}], 
      RowBox[{
       RowBox[{"euler", "[", "tt_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"hh", "=", 
            RowBox[{"N", "[", 
             RowBox[{"Pi", "/", "tt"}], "]"}]}], ",", 
           RowBox[{"xx", "=", 
            RowBox[{"aa", "/", 
             RowBox[{"(", 
              RowBox[{"2.", "*", "tt"}], ")"}]}]}], ",", 
           RowBox[{"uu", "=", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"aa", "/", "2."}], "]"}], "/", "tt"}]}], ",", "su", ",",
            "nn", ",", 
           RowBox[{"avgsu", "=", "0."}], ",", 
           RowBox[{"avgsu1", "=", "0."}]}], "}"}], ",", 
         RowBox[{
          RowBox[{"su", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0.", ",", 
             RowBox[{"{", 
              RowBox[{"mEuler", "+", "2"}], "}"}]}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"su", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Re", "[", 
              RowBox[{"funs", "[", 
               RowBox[{"xx", ",", "argu"}], "]"}], "]"}], "/", "2."}], "+", 
            RowBox[{"Sum", "[", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
               RowBox[{"Re", "[", 
                RowBox[{"funs", "[", 
                 RowBox[{
                  RowBox[{"xx", "+", 
                   RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], 
                 "]"}], "]"}]}], ",", 
              RowBox[{"{", 
               RowBox[{"nn", ",", "1", ",", "ntr"}], "}"}]}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"nn", "=", 
              RowBox[{"ntr", "+", "k"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"su", "[", 
               RowBox[{"[", 
                RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", 
              RowBox[{
               RowBox[{"su", "[", 
                RowBox[{"[", "k", "]"}], "]"}], "+", 
               RowBox[{
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
                RowBox[{"Re", "[", 
                 RowBox[{"funs", "[", 
                  RowBox[{
                   RowBox[{"xx", "+", 
                    RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], 
                  "]"}], "]"}]}]}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", 
              RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"avgsu", "=", 
              RowBox[{"avgsu", "+", 
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "*", 
                RowBox[{"su", "[", 
                 RowBox[{"[", "j", "]"}], "]"}]}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"avgsu1", "=", 
              RowBox[{"avgsu1", "+", 
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "j", "]"}], "]"}], "*", 
                RowBox[{"su", "[", 
                 RowBox[{"[", 
                  RowBox[{"j", "+", "1"}], "]"}], "]"}]}]}]}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"uu", "*", 
             RowBox[{"avgsu", "/", 
              RowBox[{"2", "^", "mEuler"}]}]}], ",", 
            RowBox[{"uu", "*", 
             RowBox[{"avgsu1", "/", 
              RowBox[{"2", "^", "mEuler"}]}]}]}], "}"}]}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"v", "=", 
       RowBox[{"euler", "[", "t", "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"inversion", " ", "at", " ", "t"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"v3", "=", 
       RowBox[{"euler", "[", 
        RowBox[{"3", "*", "t"}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"inversion", " ", "at", " ", "3", "t"}], ",", " ", 
        RowBox[{
        "used", " ", "to", " ", "estimate", " ", "the", " ", "discretization",
          " ", "error"}]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"errt", "=", 
       RowBox[{"Abs", "[", 
        RowBox[{
         RowBox[{"v", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "-", 
         RowBox[{"v", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "]"}]}], ";", 
      RowBox[{"(*", 
       RowBox[{"truncation", " ", "error", " ", 
        RowBox[{"estimate", ":", 
         RowBox[{"Abs", "[", 
          RowBox[{"fun", "-", "fun1"}], "]"}]}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"errd", "=", 
       RowBox[{
        RowBox[{"Exp", "[", 
         RowBox[{"-", "aa"}], "]"}], "*", 
        RowBox[{"Abs", "[", 
         RowBox[{"v3", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], ";", 
      RowBox[{"(*", " ", 
       RowBox[{"discretization", " ", "error", " ", 
        RowBox[{"estimate", ":", 
         RowBox[{"first", " ", "term", " ", "of", " ", 
          RowBox[{"Eq", ".", 
           RowBox[{"(", "11", ")"}]}], " ", "of", " ", "Abate", " ", "and", " ",
           "Whitt", " ", 
          RowBox[{"(", "1995", ")"}]}], ":", " ", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"-", "aa"}], "]"}], " ", 
          RowBox[{"Abs", "[", 
           RowBox[{"f", 
            RowBox[{"(", 
             RowBox[{"3", "t"}], ")"}]}], "]"}]}]}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"v", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "errt", ",", "errd", ",", 
        RowBox[{"errt", "+", "errd"}]}], "}"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0044256084934826`*^9, 4.0044256084934826`*^9}, {
   4.004448189688917*^9, 4.00444819852026*^9}, {4.0045152214110107`*^9, 
   4.0045152219623833`*^9}, {4.0045162729317913`*^9, 
   4.0045162739554024`*^9}, {4.004524011113201*^9, 4.004524024965763*^9}, 
   4.004526272112282*^9, {4.0045285073737926`*^9, 4.0045285088605137`*^9}, {
   4.0045285701594677`*^9, 4.004528598794861*^9}, {4.0045290685257874`*^9, 
   4.004529069663126*^9}, 4.004530401647808*^9, {4.00453119419656*^9, 
   4.0045312836478024`*^9}},
 Background->None,
 CellLabel->"In[71]:=",ExpressionUUID->"a61d0dee-e517-c040-996d-fd5ed5f6b4b5"]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "The functions  ",
 StyleBox["EulerILTplus and EulerILTplusPLUS ",
  FontWeight->"Bold"]
}], "Subsubsection",
 CellChangeTimes->{{3.8897617036321354`*^9, 3.889761736847932*^9}, 
   3.8897618211064625`*^9, {3.8897620935343246`*^9, 3.889762103582576*^9}, 
   3.8897904153491473`*^9, {3.8897950075362387`*^9, 3.88979501814273*^9}, {
   3.8901130192468185`*^9, 3.8901130361220045`*^9}, {3.8902213802668147`*^9, 
   3.8902214087806416`*^9}, {3.8902215147192235`*^9, 
   3.8902215376203413`*^9}, {3.8902273451933117`*^9, 3.890227345901674*^9}, {
   4.004515798368986*^9, 4.0045158084652596`*^9}, 4.0045160485844936`*^9},
 Background->None,ExpressionUUID->"cec7b915-2cd4-4e1f-951d-0f00b4478401"],

Cell[TextData[{
 StyleBox["EulerILTplus",
  FontWeight->"Bold"],
 ": \nLarger values of aa, ntr, mEuler and of the working precision give a \
more accurate but slower inversion. ",
 StyleBox["EulerILTplus",
  FontWeight->"Bold"],
 " uses aa = 30, ntr = 100, mEuler = 30 and 30 digits of working precision."
}], "Text",
 CellChangeTimes->{{3.8902194114549675`*^9, 3.890219532810182*^9}, {
   3.8902195909763627`*^9, 3.890219634933024*^9}, {3.8902212777884235`*^9, 
   3.8902213453050995`*^9}, {3.8902214434158344`*^9, 
   3.8902214565337515`*^9}, {3.8907001084174023`*^9, 3.890700133066131*^9}, 
   3.890700189929885*^9, {3.8907002762914295`*^9, 3.8907002783358493`*^9}, {
   4.004515818223732*^9, 4.004515957296316*^9}, {4.004516005304735*^9, 
   4.0045160094078445`*^9}, {4.0045246976999454`*^9, 
   4.0045247147267113`*^9}, {4.0045275997374268`*^9, 4.004527605592512*^9}, {
   4.004533429353056*^9, 4.0045334395132446`*^9}},
 Background->None,ExpressionUUID->"830d05ca-927a-45fc-a6ed-b95d0514e6cd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EulerILTplus", "[", 
    RowBox[{"funs_", ",", 
     RowBox[{"t_", "?", "Positive"}], ",", "argu_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aa", "=", "30"}], ",", 
       RowBox[{"ntr", "=", "100"}], ",", 
       RowBox[{"mEuler", "=", "30"}], ",", 
       RowBox[{"preci", "=", "30"}], ",", "hh", ",", "xx", ",", "uu", ",", 
       "c", ",", "su", ",", "nn", ",", "avgsu"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{"Warnings", ":", 
       RowBox[{"machine", "-", 
        RowBox[{
        "precision", " ", "numbers", " ", "limit", " ", "the", " ", "working",
          " ", "precision"}]}]}], "*)"}], 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Cases", "[", 
          RowBox[{"argu", ",", 
           RowBox[{"_Real", "?", "MachineNumberQ"}], ",", "Infinity"}], "]"}],
          "=!=", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{
        "Print", 
         "[", "\"\<Warning: argu contains machine-precision numbers; use \
exact numbers (e.g., 8/10).\>\"", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Precision", "[", "t", "]"}], "<", "preci"}], ",", 
        RowBox[{
        "Print", 
         "[", "\"\<Warning: t has fewer than 30 digits of precision; use an \
exact number (e.g., 1/2).\>\"", "  ", "]"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"hh", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Pi", "/", "t"}], ",", "preci"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xx", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"aa", "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", "t"}], ")"}]}], ",", "preci"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"uu", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"aa", "/", "2"}], "]"}], "/", "t"}], ",", "preci"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{"mEuler", ",", 
           RowBox[{"m", "-", "1"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "1", ",", 
           RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"su", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"mEuler", "+", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"su", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"funs", "[", 
             RowBox[{"xx", ",", "argu"}], "]"}], ",", "preci"}], "]"}], "]"}],
          "/", "2"}], "+", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
           RowBox[{"Re", "[", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"funs", "[", 
               RowBox[{
                RowBox[{"xx", "+", 
                 RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], "]"}], 
              ",", "preci"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"nn", ",", "1", ",", "ntr"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"nn", "=", 
          RowBox[{"ntr", "+", "k"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"su", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"su", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"funs", "[", 
                RowBox[{
                 RowBox[{"xx", "+", 
                  RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], "]"}],
                ",", "preci"}], "]"}], "]"}]}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "mEuler"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"avgsu", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "*", 
          RowBox[{"su", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"uu", "*", 
       RowBox[{"avgsu", "/", 
        RowBox[{"2", "^", "mEuler"}]}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0045115382177525`*^9, 4.0045115382177525`*^9}, {
   4.004512658756689*^9, 4.004512699700369*^9}, {4.0045127773564434`*^9, 
   4.0045128044604893`*^9}, {4.0045133872763805`*^9, 4.004513397003525*^9}, {
   4.0045134298040276`*^9, 4.004513458659748*^9}, {4.0045136386840477`*^9, 
   4.004513646636471*^9}, 4.004513694040289*^9, {4.0045151575005093`*^9, 
