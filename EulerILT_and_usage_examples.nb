Cell[CellGroupData[{

Cell[TextData[{
 "Example #5.  Function    ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"1", "/", 
         SuperscriptBox[
          StyleBox["s", "TI"], "2"]}], TraditionalForm], "errors" -> {}, 
     "input" -> "1/s^2", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "953cb40c-db83-4c2c-ac52-4dcfc81389e8"],
 " using larger values of A (aa), n (ntr), m (mEuler) and working precision \
(preci)"
}], "Subsubsection",
 CellChangeTimes->{{3.889793154689904*^9, 3.8897931634594345`*^9}, {
   3.8897934205322695`*^9, 3.8897934227055197`*^9}, 3.8897942228632517`*^9, 
