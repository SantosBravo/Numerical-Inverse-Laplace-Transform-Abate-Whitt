 Background->None,
 CellLabel->"In[74]:=",ExpressionUUID->"61005393-1205-4544-9c6d-8953da60360f"],

Cell[TextData[{
 "The function ",
 StyleBox["fexact1",
  FontWeight->"Bold"],
 " is the exact expression of the inverse Laplace transform of ",
 StyleBox["myfun1",
  FontWeight->"Bold"],
 ": ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SqrtBox[
          RowBox[{"\[Pi]", "/", 
            SuperscriptBox[
             StyleBox["s", "TI"], "\[Alpha]"]}]], "exp", 
         RowBox[{"[", 
           RowBox[{"-", 
             StyleBox["x", "TI"], 
             SqrtBox[
              StyleBox["s", "TI"]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sqrt{\\pi/s^\\alpha}\\exp[-x \\sqrt{s}]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f9dfe6ec-7214-47dc-9470-7adf22126ccb"]
}], "Text",
 CellChangeTimes->{{3.8901133510869246`*^9, 3.8901134018799744`*^9}, {
   3.8901134912508693`*^9, 3.8901134916987743`*^9}, 3.8901158172030897`*^9, {
   3.890135617563757*^9, 3.890135647020874*^9}},
 Background->None,ExpressionUUID->"c41914f9-4c31-4b1d-a51c-016c0359a853"],

Cell[BoxData[
 RowBox[{
  RowBox[{"fexact1", "[", 
   RowBox[{"t_", ",", "x_", ",", "\[Alpha]_"}], "]"}], ":=", " ", 
  RowBox[{
   SuperscriptBox["2", 
    RowBox[{
     RowBox[{"-", "1"}], "+", "\[Alpha]"}]], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["x", "2"], 
      RowBox[{"4", " ", "t"}]]}]], " ", 
   SuperscriptBox["t", 
    RowBox[{
     RowBox[{"-", "1"}], "+", 
     FractionBox["\[Alpha]", "2"]}]], " ", 
   RowBox[{"HermiteH", "[", 
    RowBox[{
     RowBox[{"1", "-", "\[Alpha]"}], ",", 
     FractionBox["x", 
      RowBox[{"2", " ", 
       SqrtBox["t"]}]]}], "]"}], "   ", 
   RowBox[{"(*", " ", 
    RowBox[{"\[Alpha]", "<=", "2"}], " ", "*)"}]}]}]], "Input",
 CellChangeTimes->{{3.8897609465855513`*^9, 3.8897609465875463`*^9}, 
