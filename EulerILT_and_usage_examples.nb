 Background->None,ExpressionUUID->"f8852369-03c2-4f7e-9a20-2585aa4848aa"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"myfun2", "[", 
    RowBox[{"s_", ",", 
     RowBox[{"{", "x_", "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"Pi", "/", "s"}], "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
