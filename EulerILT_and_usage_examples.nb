Cell[TextData[{
 StyleBox["EulerILTplusPLUS",
  FontWeight->"Bold"],
 ": Even larger values give a still more accurate but slower function. ",
 StyleBox["EulerILTplusPLUS",
  FontWeight->"Bold"],
 " uses aa = 80, ntr = 200, mEuler = 40 and, by default, 65 digits of working \
precision (at least 60 are recommended). It is used only in Example 5."
}], "Text",
 CellChangeTimes->{{3.8902194114549675`*^9, 3.890219532810182*^9}, {
   3.8902195909763627`*^9, 3.890219634933024*^9}, {3.8902212777884235`*^9, 
   3.8902213453050995`*^9}, {3.8902214434158344`*^9, 
   3.8902214565337515`*^9}, {3.8907001084174023`*^9, 3.890700133066131*^9}, 
   3.890700189929885*^9, {3.8907002762914295`*^9, 3.8907002783358493`*^9}, {
   4.0045156779531803`*^9, 4.004515788512615*^9}, {4.00451602782456*^9, 
   4.0045160298478947`*^9}, {4.0045301310977993`*^9, 4.004530138275696*^9}, {
   4.004533459723505*^9, 4.004533482653269*^9}},
 Background->None,ExpressionUUID->"eff9bdb7-dbed-fd44-abba-9b1e4a04147e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"EulerILTplusPLUS", "[", 
    RowBox[{"funs_", ",", 
     RowBox[{"t_", "?", "Positive"}], ",", "argu_List", ",", 
     RowBox[{"preci_", ":", "65"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"aa", "=", "80"}], ",", 
       RowBox[{"ntr", "=", "200"}], ",", 
       RowBox[{"mEuler", "=", "40"}], ",", "hh", ",", "xx", ",", "uu", ",", 
       "c", ",", "su", ",", "nn", ",", "avgsu"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Working", " ", 
       RowBox[{"precision", ":", 
        RowBox[{"65", " ", "digits", " ", "by", " ", "default"}]}]}], " ", 
      "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"preci", ">", "$MachinePrecision"}], "&&", 
         RowBox[{
          RowBox[{"Cases", "[", 
           RowBox[{"argu", ",", 
            RowBox[{"_Real", "?", "MachineNumberQ"}], ",", "Infinity"}], 
           "]"}], "=!=", 
          RowBox[{"{", "}"}]}]}], ",", 
        RowBox[{
        "Print", 
         "[", "\"\<Warning: argu contains machine-precision numbers; use \
exact numbers (e.g., 8/10).\>\"", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"preci", "<", "60"}], ",", 
        RowBox[{
        "Print", 
         "[", "\"\<Warning: at least 60 digits of working precision are \
recommended.\>\"", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Precision", "[", "t", "]"}], "<", "preci"}], ",", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Warning: t has fewer than \>\"", " ", "<>", " ", 
          RowBox[{"ToString", "[", "preci", "]"}], " ", "<>", 
          " ", "\"\< digits of precision;use an exact number \
(e.g.,1/2)\>\""}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"hh", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"Pi", "/", "t"}], ",", "preci"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xx", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{"aa", "/", 
          RowBox[{"(", 
           RowBox[{"2", "*", "t"}], ")"}]}], ",", "preci"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"uu", "=", 
       RowBox[{"N", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{"aa", "/", "2"}], "]"}], "/", "t"}], ",", "preci"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"c", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Binomial", "[", 
          RowBox[{"mEuler", ",", 
           RowBox[{"m", "-", "1"}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"m", ",", "1", ",", 
           RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"su", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"0", ",", 
         RowBox[{"{", 
          RowBox[{"mEuler", "+", "1"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"su", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Re", "[", 
          RowBox[{"N", "[", 
           RowBox[{
            RowBox[{"funs", "[", 
             RowBox[{"xx", ",", "argu"}], "]"}], ",", "preci"}], "]"}], "]"}],
          "/", "2"}], "+", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
           RowBox[{"Re", "[", 
            RowBox[{"N", "[", 
             RowBox[{
              RowBox[{"funs", "[", 
               RowBox[{
                RowBox[{"xx", "+", 
                 RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], "]"}], 
              ",", "preci"}], "]"}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"nn", ",", "1", ",", "ntr"}], "}"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Do", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"nn", "=", 
          RowBox[{"ntr", "+", "k"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"su", "[", 
           RowBox[{"[", 
            RowBox[{"k", "+", "1"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{"su", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "+", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "^", "nn"}], "*", 
            RowBox[{"Re", "[", 
             RowBox[{"N", "[", 
              RowBox[{
               RowBox[{"funs", "[", 
                RowBox[{
                 RowBox[{"xx", "+", 
                  RowBox[{"I", "*", "nn", "*", "hh"}]}], ",", "argu"}], "]"}],
                ",", "preci"}], "]"}], "]"}]}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "1", ",", "mEuler"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"avgsu", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"c", "[", 
           RowBox[{"[", "j", "]"}], "]"}], "*", 
          RowBox[{"su", "[", 
           RowBox[{"[", "j", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "1", ",", 
           RowBox[{"mEuler", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"uu", "*", 
       RowBox[{"avgsu", "/", 
        RowBox[{"2", "^", "mEuler"}]}]}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{4.0045143816659946`*^9, 4.0045143816659946`*^9}, {
   4.0045144643913994`*^9, 4.004514488652382*^9}, 4.0045145622758274`*^9, {
   4.004514700787428*^9, 4.004514782563652*^9}, 4.004514828803877*^9, {
   4.0045148923160706`*^9, 4.0045148934116917`*^9}, {4.0045150663960915`*^9, 
   4.004515147059908*^9}, {4.0045164492770977`*^9, 4.004516449804018*^9}, {
   4.004524813621937*^9, 4.004524821645302*^9}, {4.004529168506439*^9, 
   4.0045291689113693`*^9}, {4.0045292043484364`*^9, 
   4.0045292207738495`*^9}, {4.0045293201213703`*^9, 
   4.0045293466910152`*^9}, {4.0045304644606495`*^9, 4.0045305278088875`*^9}, 
   4.0045307149992027`*^9, 4.0045313393111877`*^9, {4.0045314901012287`*^9, 
   4.004531526494713*^9}, {4.0045315592333603`*^9, 4.004531565717289*^9}},
 Background->None,
 CellLabel->"In[73]:=",ExpressionUUID->"a635bf68-33ea-fc40-9b4c-24f9d9249313"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell[TextData[{
 "Usage examples of ",
 StyleBox["EulerILT",
  FontWeight->"Bold"],
 ", ",
 StyleBox["EulerILTwithErrors",
  FontWeight->"Bold"],
 ", ",
 StyleBox["EulerILTplus",
  FontWeight->"Bold"],
 " and ",
 StyleBox["EulerILTplusPLUS",
  FontWeight->"Bold"]
}], "Subsection",
 CellChangeTimes->{{3.8897943784878983`*^9, 3.8897943790021243`*^9}, {
   3.890113906976897*^9, 3.890113910989889*^9}, {3.8901166509665723`*^9, 
   3.8901166511286364`*^9}, {3.8901320919658914`*^9, 
   3.8901320978348703`*^9}, {3.8901321305792856`*^9, 3.890132156483384*^9}, {
   3.890136964180236*^9, 3.890136967859642*^9}, {3.8902216257157173`*^9, 
   3.8902216290058413`*^9}, 3.8902265290038357`*^9, {3.890227447172015*^9, 
   3.8902274557610455`*^9}, {4.004533510775013*^9, 4.004533512765539*^9}, 
   4.004534852799238*^9},
 Background->None,ExpressionUUID->"87b898d4-4871-4107-90a3-41e837efe05b"],

Cell[TextData[{
 "The function ",
 StyleBox["myfun",
  FontWeight->"Bold"],
 " is the function whose inverse Laplace transform we want to compute. Its \
format is ",
 StyleBox["myfun[s, argu]",
  FontWeight->"Bold"],
 ", where ",
 StyleBox["s",
  FontWeight->"Bold"],
 " is the Laplace variable and ",
 StyleBox["argu",
  FontWeight->"Bold"],
 " is a list containing all the other parameters of the function."
}], "Text",
 CellChangeTimes->{{3.8897954689346895`*^9, 3.88979563198308*^9}, {
   3.889795662724676*^9, 3.889796183958815*^9}, {3.8901138219662156`*^9, 
   3.8901138782731295`*^9}, {3.890113921710988*^9, 3.8901139674648447`*^9}, {
   3.890114021351723*^9, 3.890114033351265*^9}, {3.8901140736281366`*^9, 
   3.8901141000308285`*^9}, {3.8901141370179167`*^9, 3.890114137612015*^9}, 
   3.8901141687223268`*^9, 3.8901142624115896`*^9, {3.8901166659806547`*^9, 
   3.8901166661785793`*^9}, {3.8901167220946484`*^9, 
   3.8901167907287736`*^9}, {3.890116861353114*^9, 3.8901168642148743`*^9}, {
   3.890134791368931*^9, 3.890134807497696*^9}, {3.8901369996175313`*^9, 
   3.8901370493199215`*^9}, {3.8902272299363804`*^9, 3.890227247752947*^9}, {
   4.0045335413629913`*^9, 4.004533563941492*^9}},
 Background->None,ExpressionUUID->"bdcfe051-3c00-40b4-a818-5beced24fe34"],

Cell[TextData[{
 "For example, if the function to invert is    ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SqrtBox[
          RowBox[{"\[Pi]", "/", 
            SuperscriptBox[
             StyleBox["s", "TI"], "\[Alpha]"]}]], "exp", 
         RowBox[{"(", 
           RowBox[{"-", 
             StyleBox["x", "TI"], 
             SqrtBox[
              StyleBox["s", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sqrt{\\pi/s^\\alpha} \\exp(-x\\sqrt{s})", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9f018ff5-281c-47dc-8437-0efd76c1ffdb"],
 " , then ",
 StyleBox["argu",
  FontWeight->"Bold"],
 " is ",
 StyleBox["{x,\[Alpha]}",
  FontWeight->"Bold"],
 "  and ",
 StyleBox["myfun",
  FontWeight->"Bold"],
 " should be   ",
 StyleBox["myfun[s_,{x_,\[Alpha]_}]:=Sqrt[Pi/s^\[Alpha]] Exp[-x*Sqrt[s]]\n ",
  FontWeight->"Bold"],
 "If there are no parameters, such as when the the function to invert is ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SqrtBox[
          RowBox[{"\[Pi]", "/", 
            StyleBox["s", "TI"]}]], "exp", 
         RowBox[{"(", 
           RowBox[{"-", 
             SqrtBox[
              StyleBox["s", "TI"]]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sqrt{\\pi/s} \\exp(-\\sqrt{s})", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "960c5f7a-4a69-f440-9364-e0ed4925dc6d"],
 " , then ",
 StyleBox["argu",
  FontWeight->"Bold"],
 " is a empty list  (i.e.,  ",
 StyleBox["argu",
  FontWeight->"Bold"],
 " is ",
 StyleBox["{}",
  FontWeight->"Bold"],
 " ) and ",
 StyleBox["myfun",
  FontWeight->"Bold"],
 " is  ",
 StyleBox["myfun[s_,{}]:=Sqrt[Pi/s] Exp[-Sqrt[s]]",
  FontWeight->"Bold"],
 "\nSee  the sections \[OpenCurlyDoubleQuote]Example #n\
\[CloseCurlyDoubleQuote] below for more details on this. "
}], "Text",
 CellChangeTimes->{{3.8897954689346895`*^9, 3.88979563198308*^9}, {
   3.889795662724676*^9, 3.889796183958815*^9}, {3.8901138219662156`*^9, 
   3.8901138782731295`*^9}, {3.890113921710988*^9, 3.8901139674648447`*^9}, {
   3.890114021351723*^9, 3.890114033351265*^9}, {3.8901140736281366`*^9, 
   3.8901141000308285`*^9}, {3.8901141370179167`*^9, 3.890114137612015*^9}, 
   3.890114262436304*^9, {3.8901143019059486`*^9, 3.8901143034098196`*^9}, {
   3.890137075194993*^9, 3.8901370934472136`*^9}, {3.890137140977401*^9, 
   3.8901371527013893`*^9}, {3.8902272902927513`*^9, 
   3.8902273012427626`*^9}, {4.0045335764612503`*^9, 
   4.0045336387937946`*^9}, {4.0045336831627254`*^9, 4.00453374466317*^9}},
 Background->None,ExpressionUUID->"5bf95db4-7d5c-49cb-85da-3c2c5830f33b"],

Cell[CellGroupData[{

Cell[TextData[{
 "Example #1.  Function   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SqrtBox[
          RowBox[{"\[Pi]", "/", 
            SuperscriptBox[
             StyleBox["s", "TI"], "\[Alpha]"]}]], "exp", 
         RowBox[{"[", 
           RowBox[{"-", 
             StyleBox["x", "TI"], 
             SqrtBox[
              StyleBox["s", "TI"]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sqrt{\\pi/s^\\alpha}\\exp[-x \\sqrt{s}]", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "43e6fcfd-4e73-422a-947a-237ef45682f9"],
 ",  where  ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       StyleBox["s", "TI"], TraditionalForm], "errors" -> {}, "input" -> "s", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3cf0afd4-33c2-4ff1-9353-5024d73b4507"],
 " is the Laplace variable "
}], "Subsubsection",
 CellChangeTimes->{{3.889793154689904*^9, 3.8897931634594345`*^9}, {
   3.8897934205322695`*^9, 3.8897934227055197`*^9}, 3.889793537538062*^9, {
