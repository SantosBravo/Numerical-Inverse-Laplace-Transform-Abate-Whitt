Cell[TextData[{
 "Example #3. Function   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SqrtBox[
          RowBox[{"\[Pi]", "/", 
            StyleBox["s", "TI"]}]], "exp", 
         RowBox[{"[", 
           RowBox[{"-", 
             SqrtBox[
              StyleBox["s", "TI"]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sqrt{\\pi/s}\\exp[-\\sqrt{s}]", "state" -> 
     "Boxes"|>,
