Cell[TextData[{
 "Example #2.  Function   ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SqrtBox[
          RowBox[{"\[Pi]", "/", 
            StyleBox["s", "TI"]}]], "exp", 
         RowBox[{"[", 
           RowBox[{"-", 
             StyleBox["x", "TI"], 
             SqrtBox[
              StyleBox["s", "TI"]]}], "]"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sqrt{\\pi/s}\\exp[-x \\sqrt{s}]", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "89fd387e-5024-4ce5-b989-9c33a5ff7205"]
}], "Subsubsection",
