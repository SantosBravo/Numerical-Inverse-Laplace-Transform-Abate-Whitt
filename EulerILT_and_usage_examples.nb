Cell[TextData[{
 StyleBox["myfun1",
  FontWeight->"Bold"],
 " is the function to be inverted numerically."
}], "Text",
 CellChangeTimes->{{3.8901134240846424`*^9, 3.89011348174165*^9}, {
   3.8901143652013392`*^9, 3.8901143722061925`*^9}, 3.8901356148204074`*^9, {
   3.8901371678553405`*^9, 3.8901371717027335`*^9}, {4.004533772865406*^9, 
   4.004533775204155*^9}},
 Background->None,ExpressionUUID->"8465766d-6d67-4ddb-bd4e-de6dc91808c2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"myfun1", "[", 
    RowBox[{"s_", ",", 
     RowBox[{"{", 
      RowBox[{"x_", ",", "\[Alpha]_"}], "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"Pi", "/", 
      RowBox[{"s", "^", "\[Alpha]"}]}], "]"}], " ", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", "x"}], "*", 
      RowBox[{"Sqrt", "[", "s", "]"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.889760960379586*^9, 3.889760960383577*^9}, {
   3.8897611625132256`*^9, 3.8897611626958237`*^9}, {3.889762221285349*^9, 
   3.889762338098876*^9}, 3.8897631477684183`*^9, {3.88979070456168*^9, 
