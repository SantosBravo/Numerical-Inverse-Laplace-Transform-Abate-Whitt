Cell[TextData[{
 StyleBox["myfun2",
  FontWeight->"Bold"],
 " is the function to be inverted numerically "
}], "Text",
 CellChangeTimes->{{3.8901134240846424`*^9, 3.89011348174165*^9}, {
   3.8901143652013392`*^9, 3.8901143722061925`*^9}, 3.8901356375511055`*^9, {
