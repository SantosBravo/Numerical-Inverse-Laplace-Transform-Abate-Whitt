 RowBox[{
  RowBox[{
   RowBox[{"myfun3", "[", 
    RowBox[{"s_", ",", 
     RowBox[{"{", "}"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     RowBox[{"Pi", "/", "s"}], "]"}], " ", 
